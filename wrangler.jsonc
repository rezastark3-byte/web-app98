{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app98",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3b40ffd8-9e0e-4667-84de-7a164cc7d715","database_name": "web-app98" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bfbbd80597aa433f8a22763ae7ab0328" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
